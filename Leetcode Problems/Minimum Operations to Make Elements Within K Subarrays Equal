
var minOperations = function(A, x, k) {
    const n = A.length;
    
    
    const u = Array.from(new Set(A)).sort((a, b) => a - b);
    const m = u.length;

    const getIdx = (v) => {
        let l = 0, r = m - 1;
        while (l <= r) {
            const mid = (l + r) >> 1;
            if (u[mid] === v) return mid + 1;
            u[mid] < v ? (l = mid + 1) : (r = mid - 1);
        }
        return 1;
    };

    
    const C = new Int32Array(m + 1);
    const S = new Float64Array(m + 1);

    const add = (v, d) => {
        for (let i = getIdx(v); i <= m; i += i & -i) {
            C[i] += d;
            S[i] += d * v;
        }
    };

    const qry = (i) => {
        let c = 0, s = 0;
        for (; i > 0; i -= i & -i) {
            c += C[i];
            s += S[i];
        }
        return [c, s];
    };

    const cost = new Float64Array(n + 1);
    const req = (x + 1) >> 1;

    
    let maxBit = 1;
    while ((maxBit << 1) <= m) maxBit <<= 1;

    for (let i = 0; i < n; i++) {
        add(A[i], 1);
        if (i >= x) add(A[i - x], -1);

        if (i >= x - 1) {
            let idx = 0, rem = req;
            for (let step = maxBit; step > 0; step >>= 1) {
                if (idx + step <= m && C[idx + step] < rem) {
                    idx += step;
                    rem -= C[idx];
                }
            }
            idx++;
            const med = u[idx - 1];
            const [lc, ls] = qry(idx);
            const [tc, ts] = qry(m);
            const rc = tc - lc;
            const rs = ts - ls;

            cost[i + 1] = (lc * med - ls) + (rs - rc * med);
        }
    }

    let dp = new Float64Array(n + 1);
    for (let j = 1; j <= k; j++) {
        const nxt = new Float64Array(n + 1).fill(Infinity);
        let minP = Infinity;
        for (let i = j * x; i <= n; i++) {
            if (dp[i - x] < minP) minP = dp[i - x];
            const val = minP + cost[i];
            nxt[i] = nxt[i - 1] < val ? nxt[i - 1] : val;
        }
        dp = nxt;
    }

    return dp[n];
};
