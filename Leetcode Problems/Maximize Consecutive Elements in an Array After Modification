
var maxSelectedElements = function(nums) {
    let best = 1, keep = 1, bump = 1, last = -10;
    for (const x of nums.sort((a, b) => a - b)) {
        switch (x - last) {
            case 0: bump = keep + 1; break;  // x repeat: bump it on top of keep
            case 1: [keep, bump] = [keep + 1, bump + 1]; break;  // x extends keep, x + 1 extends bump
            case 2: [keep, bump] = [bump + 1, 1]; break;  // x extends bump, x + 1 starts over
            default: keep = bump = 1;
        }
        [best, last] = [Math.max(best, keep, bump), x];
    }
    return best;
};
