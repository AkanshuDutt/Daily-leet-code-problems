/**
 * LeetCode 3331. Find Subtree Sizes After Changes
 * https://leetcode.com/problems/find-subtree-sizes-after-changes/
 *
 * Approach: Iterative DFS on the original tree. last[26] tracks the nearest
 * ancestor of each letter; the closest same-letter ancestor becomes the new
 * parent. Subtree sizes are then accumulated in reverse DFS order.
 *
 * Time: O(n) — each node is visited a constant number of times
 * Space: O(n) — child lists, rewritten parents, and the DFS order
 *
 * @param {number[]} parent
 * @param {string} s
 * @return {number[]}
 */
var findSubtreeSizes = function(parent, s) {
    const n = s.length;
    const ch = Array.from({ length: n }, () => []);
    for (let i = 1; i < n; i++) ch[parent[i]].push(i);
    const np = parent.slice();
    const last = new Array(26).fill(-1);
    const prev = new Array(n).fill(-1);
    const ord = [];
    const ptr = new Array(n).fill(0);
    const st = [0];
    let c = s.charCodeAt(0) - 97;
    prev[0] = last[c];
    last[c] = 0;
    ord.push(0);
    while (st.length) {
        const u = st[st.length - 1];
        if (ptr[u] < ch[u].length) {
            const v = ch[u][ptr[u]++];
            const k = s.charCodeAt(v) - 97;
            if (last[k] >= 0) np[v] = last[k];
            prev[v] = last[k];
            last[k] = v;
            ord.push(v);
            st.push(v);
        } else {
            last[s.charCodeAt(u) - 97] = prev[u];
            st.pop();
        }
    }
    const ans = new Array(n).fill(1);
    for (let i = n - 1; i > 0; i--) {
        const v = ord[i];
        ans[np[v]] += ans[v];
    }
    return ans;
};
